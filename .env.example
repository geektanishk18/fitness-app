# Public Supabase client configuration. These are safe to expose in the browser;
# Row Level Security is the access control boundary.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only integrations
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
GROQ_API_KEY=replace-with-server-only-groq-api-key
